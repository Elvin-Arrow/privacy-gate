{
  "identifier": "default",
  "description": "Default capabilities for Privacy Gate webview",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "allow-get-session-state",
    "allow-create-account",
    "allow-unlock",
    "allow-lock",
    "allow-change-passphrase",
    "allow-get-account",
    "allow-get-integrity-report",
    "allow-get-retention-default",
    "allow-set-retention-default",
    "allow-get-detector-preference",
    "allow-set-detector-preference",
    "allow-import-document",
    "allow-list-documents",
    "allow-get-document",
    "allow-delete-document",
    "allow-delete-retained-original",
    "allow-open-approval",
    "allow-get-approval-view",
    "allow-set-field-decisions",
    "allow-submit-approval",
    "allow-abort-approval",
    "allow-list-variants",
    "allow-get-variant",
    "allow-save-variant",
    "allow-delete-variant",
    "allow-preview-share",
    "allow-commit-share",
    "allow-cloud-ai-set-config",
    "allow-cloud-ai-get-config",
    "allow-cloud-ai-clear-config",
    "allow-cloud-ai-test",
    "allow-list-audit-events"
  ],
  "deny": [
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-watch",
    "http:default",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open",
    "dialog:allow-open"
  ]
}
